{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workflow",
  "description": "Allow the main ArgusFlow window to validate and run in-memory workflows.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-validate-workflow",
    "allow-run-workflow"
  ]
}
