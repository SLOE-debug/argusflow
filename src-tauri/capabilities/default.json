{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workflow",
  "description": "Allow the main ArgusFlow window to run workflows, control recording and read local history.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-begin-runtime-initialization",
    "allow-get-startup-status",
    "allow-retry-startup",
    "allow-list-runs",
    "allow-get-run",
    "allow-read-run-events",
    "allow-read-run-artifact",
    "allow-validate-workflow",
    "allow-run-workflow",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-get-recording-status",
    "allow-list-recordings",
    "allow-get-recording"
  ]
}
